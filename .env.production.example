# Use a DNS name pointing to the deployment host. Caddy obtains and renews HTTPS certificates.
SITE_ADDRESS=shield.example.com
SITE_USER=reviewer
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'choose-a-long-unique-password'
# In .env.production, double each `$` in the resulting hash so Compose preserves it.
SITE_PASSWORD_HASH=replace_with_caddy_password_hash
