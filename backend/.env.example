# Local-only data directory. Keep uploaded media and evidence out of Git.
DEEP_SHIELD_DATA_DIR=./data

# Prototype limits; configure for the demo machine and document any change.
DEEP_SHIELD_MAX_UPLOAD_BYTES=104857600
DEEP_SHIELD_MAX_VIDEO_SECONDS=60

# Comma-separated browser origins allowed to call the API.
DEEP_SHIELD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
